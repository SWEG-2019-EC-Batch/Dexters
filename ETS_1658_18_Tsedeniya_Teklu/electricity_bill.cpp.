
#include <iostream>
#include <iomanip>
using namespace std;

/*
================================================
TASK 2: ELECTRICITY BILL CALCULATION
================================================

INPUT:
- Electricity units consumed.

PROCESS:
1. Read the number of electricity units.
2. Check whether units are 50 or less.
3. If units are 50 or less:
   Energy charge = units * 1.50.
4. Otherwise:
   First 50 units cost 1.50 per unit.
   Additional units cost 2.00 per unit.
5. Add the service charge of 10 birr.
6. Calculate the total bill.

OUTPUT:
- Energy charge
- Service charge
- Total electricity bill

FLOWCHART:

       +-----------+
       |   START   |
       +-----------+
             |
             v
   +---------------------+
   | Enter units used    |
   +---------------------+
             |
             v
       +-------------+
       | Units <= 50?|
       +-------------+
          /       \
        Yes        No
         |          |
         v          v
 +---------------+ +-------------------+
 | Units * 1.50  | | 50 * 1.50 +        |
 |               | | (Units-50) * 2.00  |
 +---------------+ +-------------------+
          \          /
           \        /
             v
   +---------------------+
   | Add service charge  |
   | of 10 birr          |
   +---------------------+
             |
             v
   +---------------------+
   | Calculate total bill|
   +---------------------+
             |
             v
   +---------------------+
   | Display bill        |
   +---------------------+
             |
             v
       +-----------+
       |    END    |
       +-----------+
================================================
*/

int main() {
    int units;
    double energyCharge;
    double serviceCharge = 10.00;
    double totalBill;

    // INPUT
    cout << "Enter electricity units: ";
    cin >> units;

    // PROCESS
    energyCharge = (units <= 50)
        ? units * 1.50
        : (50 * 1.50) + ((units - 50) * 2.00);

    totalBill = energyCharge + serviceCharge;

    // OUTPUT
    cout << fixed << setprecision(2);

    cout << "\nEnergy Charge: " << energyCharge << " birr" << endl;
    cout << "Service Charge: " << serviceCharge << " birr" << endl;
    cout << "Total Bill: " << totalBill << " birr" << endl;

    return 0;
}

